# Get this from https://app.heygen.com -> Settings -> API (Subscriptions & API)
HEYGEN_API_KEY=your_heygen_api_key_here

# Your data API endpoint. The server fetches JSON from here and turns it into
# a spoken script for the avatar.
DATA_API_URL=https://api.example.com/feed

# Pick these using GET https://api.heygen.com/v2/avatars and /v2/voices
# (or run: npm start, then open http://localhost:3000/api/avatars)
HEYGEN_AVATAR_ID=30973494479f4bbd944026f2fbb981c4
HEYGEN_VOICE_ID=330290724a1b470fb63153f34d4c0183

PORT=3000
